# Copia este archivo a .env (no se sube a Git) y completa los valores.
PORT=3000
# Clave compartida con Django (cabecera X-API-Key). Usa un valor largo y aleatorio.
SERVICE_API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
# API key de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=25000
# URL publica del servicio (opcional, aparece en Swagger)
PUBLIC_URL=
