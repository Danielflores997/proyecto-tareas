# Copia este archivo a .env (no se sube a Git) antes de ejecutar docker compose.

# API key de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Clave compartida entre Django y el microservicio (usa una larga y aleatoria).
SERVICE_API_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

SECRET_KEY=cambia-esta-clave-de-django

# Opcional: crea el usuario de /admin al arrancar el contenedor
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
